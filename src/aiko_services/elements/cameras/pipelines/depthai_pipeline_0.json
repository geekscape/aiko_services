{
  "version": 0,
  "name":    "p_depthai_0",
  "runtime": "python",

  "#": ["Luxonis OAK camera (depthai://): discover it on the local network,",
        "read 1920x1080 at 25 fps, show it for 10 s (or press 'x').",
        "One camera: -p VideoReadDepthAI.data_sources '(depthai://<address>)'",
        "The camera's own resolution is the element parameter; the",
        "Pipeline-level resolution is the ImageResize target"],

  "graph": ["(VideoReadDepthAI CaptureLimit ImageResize VideoShow)"],

  "parameters": {
    "_create_stream_":       "1",
    "_destroy_stream_exit_": "1",
    "resolution":            "960x540"
  },

  "elements": [
    { "name":   "VideoReadDepthAI",
      "parameters": {
        "data_sources": "(depthai://)",
        "resolution":   "1920x1080",
        "frame_rate":   25.0,
        "settle":       "30"
      },
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [{"name": "images", "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.cameras.depthai_io"}
      }
    },
    { "name":   "CaptureLimit",
      "parameters": {"duration": 10.0},  "#": "seconds, or e.g '10m'",
      "input":  [],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.elements.control.elements"}
      }
    },
    { "name":   "ImageResize",
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [{"name": "images", "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.image_io"}
      }
    },
    { "name":   "VideoShow",
      "parameters": {
        "title":       "Luxonis OAK camera",
        "position":    "0:0",
        "system_exit": false
      },  "#": "system_exit false: 'x' returns STOP, a graceful destroy",
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.video_io"}
      }
    }
  ]
}
