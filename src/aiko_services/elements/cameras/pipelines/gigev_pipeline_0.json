{
  "version": 0,
  "name":    "p_gigev_0",
  "runtime": "python",

  "#": ["GigE Vision camera (gigev://) through IDS peak, or Aravis as the",
        "experimental backend: the first camera found, 1920x1080 at 8 fps,",
        "shown for 10 s (or press 'x').  The exposure is set by the highlight",
        "auto-expose before the first frame; fix it instead with",
        "-p VideoReadGigE.exposure_us 20000 -p VideoReadGigE.gain 2.0",
        "One camera: -p VideoReadGigE.data_sources '(gigev://<address>)'"],

  "graph": ["(VideoReadGigE CaptureLimit ImageResize VideoShow)"],

  "parameters": {
    "_create_stream_":       "1",
    "_destroy_stream_exit_": "1",
    "resolution":            "960x540"
  },

  "elements": [
    { "name":   "VideoReadGigE",
      "parameters": {
        "data_sources": "(gigev://)",
        "backend":      "auto",
        "resolution":   "1920x1080",
        "frame_rate":   8.0
      },
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [{"name": "images", "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.cameras.gigev_io"}
      }
    },
    { "name":   "CaptureLimit",
      "parameters": {"duration": 10.0},  "#": "seconds, or e.g '10m'",
      "input":  [],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.elements.control.elements"}
      }
    },
    { "name":   "ImageResize",
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [{"name": "images", "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.image_io"}
      }
    },
    { "name":   "VideoShow",
      "parameters": {
        "title":       "GigE Vision camera",
        "position":    "0:0",
        "system_exit": false
      },  "#": "system_exit false: 'x' returns STOP, a graceful destroy",
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.video_io"}
      }
    }
  ]
}
